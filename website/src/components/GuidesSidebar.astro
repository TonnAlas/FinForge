---
import { getGuides } from '../lib/guides';

const base = import.meta.env.BASE_URL;

interface Props {
  currentSlug?: string;
  isIndex?: boolean;
}

const { currentSlug, isIndex = false } = Astro.props;
const guides = await getGuides();
---

<aside class="docs-sidebar">
  <a href={`${base}docs/`}>Overview</a>
  <a href={`${base}docs/installation/`}>Installation</a>
  <a href={`${base}docs/features/`}>Features</a>
  <a href={`${base}docs/guides/`} class:list={[isIndex ? 'active' : '']}>Guides</a>
  <a href={`${base}docs/disclaimer/`}>Disclaimer</a>
  <div class="docs-sidebar-label">User guides</div>
  {guides.map((guide) => (
    <a href={`${base}docs/guides/${guide.slug}/`} class:list={[currentSlug === guide.slug ? 'active' : '']}>
      {guide.title}
    </a>
  ))}
</aside>
