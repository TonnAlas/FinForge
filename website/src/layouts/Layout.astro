---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FinForge',
  description = 'FinForge brings live stock data, side-by-side charts, and a familiar Excel dashboard together in one simple app for investors.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const nav = [
  { label: 'Home', href: `${base}` },
  { label: 'Docs', href: `${base}docs/` },
  { label: 'Installation', href: `${base}docs/installation/` },
  { label: 'Features', href: `${base}docs/features/` },
  { label: 'Guides', href: `${base}docs/guides/` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>
          <span class="brand-mark">&gt;ƒ</span>
          <span class="brand-name">FinForge</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: currentPath === item.href }]}>
              {item.label}
            </a>
          ))}
          <a class="nav-link external" href="https://github.com/TonnAlas/FinForge">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="container main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>FinForge - MIT License</span>
        <nav class="footer-links" aria-label="Legal">
          <a href={`${base}docs/disclaimer/`}>Financial disclaimer</a>
          <a href="https://github.com/TonnAlas/FinForge">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
