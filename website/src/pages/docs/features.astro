---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const features = [
  { name: 'Live Market Data', desc: 'Prices and company fundamentals refresh automatically from the market.' },
  { name: 'Fast and Responsive', desc: 'Data is stored in an optimized format (Parquet) so the app stays quick as your library grows.' },
  { name: 'Desktop Workspace', desc: 'A modern desktop app with simple sidebar navigation keeps everything within reach.' },
  { name: 'Excel Dashboard', desc: 'An interactive dashboard built directly into Excel, so it feels familiar.' },
  { name: 'Interactive Charts', desc: 'Zoomable charts compare multiple stocks and ratios side by side, with dual axes and range sliders.' },
  { name: 'Custom Ratios', desc: 'Build your own financial ratios with a visual builder, with no manual formula typing.' },
  { name: 'Multi-Stock Tracking', desc: 'Follow and compare many companies at the same time.' },
  { name: 'Ranking Dashboard', desc: 'Score a set of stocks across user-selected metrics with a weighted multi-criteria model, shape each metric\'s scoring curve visually with draggable handles, save presets, and explore a full-screen sortable results table.' },
  { name: 'Automatic Calculations', desc: 'Ratios update on their own whenever new data arrives.' },
  { name: 'Statement Import', desc: 'Pick which line items to pull into Excel, from the balance sheet, income statement, or cash flow.' },
  { name: 'Research Search', desc: 'Search for equity research and analyst notes from inside the app.' },
  { name: 'Company Profiles', desc: 'A clean summary of key information for any company.' },
  { name: 'Cash Flow Import', desc: 'Bring cash flow statements in alongside the balance sheet and income statement.' },
  { name: 'Template System', desc: 'Save and reload workbook layouts so your setup is ready next time.' },
  { name: 'Excel Add-in', desc: 'Launch FinForge directly from the Excel ribbon.' },
];
---

<Layout title="Features - FinForge">
  <div class="docs-grid">
    <aside class="docs-sidebar">
      <a href={`${base}docs/`}>Overview</a>
      <a href={`${base}docs/installation/`}>Installation</a>
      <a href={`${base}docs/features/`} class:list={['active']}>Features</a>
      <a href={`${base}docs/guides/`}>Guides</a>
      <a href={`${base}docs/disclaimer/`}>Disclaimer</a>
    </aside>
    <div class="docs-content">
      <h1>Features</h1>
      <p>A plain-English tour of what FinForge can do.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Feature</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            {features.map((feature) => (
              <tr>
                <td>{feature.name}</td>
                <td>{feature.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
