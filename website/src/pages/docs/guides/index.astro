---
import Layout from '../../../layouts/Layout.astro';
import GuidesSidebar from '../../../components/GuidesSidebar.astro';
import { getGuides } from '../../../lib/guides';

const base = import.meta.env.BASE_URL;
const guides = await getGuides();
---

<Layout title="User Guides - FinForge">
  <div class="docs-grid">
    <GuidesSidebar isIndex={true} />
    <div class="docs-content">
      <h1>User Guides</h1>
      <p>
        Step-by-step documentation for using FinForge, from first setup to
        building your own financial ratios.
      </p>
      <div class="grid">
        {guides.map((guide) => (
          <article class="card">
            <h3><a href={`${base}docs/guides/${guide.slug}/`}>{guide.title}</a></h3>
            <p>{guide.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
