---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const features = [
  { title: 'Live Market Data', text: 'Up-to-date prices and company fundamentals, pulled in automatically.' },
  { title: 'Fast and Responsive', text: 'Data is stored efficiently so the app stays quick, even with a large library.' },
  { title: 'Clean Desktop App', text: 'A modern workspace with search, charts, and tools in one simple sidebar.' },
  { title: 'Works in Excel', text: 'An interactive dashboard built right into the spreadsheet you already know.' },
  { title: 'Interactive Charts', text: 'Zoomable charts that let you compare stocks and ratios side by side.' },
  { title: 'Build Your Own Formulas', text: 'Create custom financial ratios visually, with no coding or formula typing.' },
  { title: 'Track Multiple Stocks', text: 'Follow and compare as many companies as you want, all in one place.' },
  { title: 'Ranking Dashboard', text: 'Score and rank companies against your own weighted metrics, with adjustable curves and a sortable results view.' },
  { title: 'Pick What You Import', text: 'Choose exactly which line items appear in your workbook.' },
  { title: 'Find Research Fast', text: 'Search for analyst and equity research without leaving the app.' },
  { title: 'Company Snapshots', text: 'See the key details for any company you follow, at a glance.' },
  { title: 'Save Your Setup', text: 'Reuse saved workbook templates so you never start from scratch.' },
  { title: 'One Click from Excel', text: 'Launch the full workspace straight from the Excel ribbon.' },
];
---

<Layout title="FinForge - Financial Analysis Tool">
  <section class="hero">
    <p class="eyebrow">For those who respect fundamentals</p>
    <h1>FinForge</h1>
    <p class="lede">
      Turn raw market data into clear answers. FinForge brings live stock data,
      side-by-side charts, and a familiar Excel dashboard together in one simple app,
      so you can research companies and track your own financial ratios without writing a line of code.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={`${base}docs/installation/`}>Get started</a>
      <a class="button button-secondary" href={`${base}docs/features/`}>See features</a>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Features</h2>
    <div class="grid">
      {features.map((feature) => (
        <article class="card">
          <h3>{feature.title}</h3>
          <p>{feature.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Getting started</h2>
    <ol>
      <li>Download the project.</li>
      <li>Run <code>setup.bat</code>.</li>
      <li>Launch <code>launch_finforge.bat</code> and open your dashboard.</li>
    </ol>
    <p>No coding required. <a href={`${base}docs/installation/`}>See the full guide</a></p>
  </section>

  <section class="section">
    <p class="disclaimer-note">
      FinForge is a tool for organizing and analyzing market data, not financial
      advice. Always do your own research before making investment decisions.
      <a href={`${base}docs/disclaimer/`}>Read the full disclaimer</a>.
    </p>
  </section>
</Layout>
